{
  "name": "@harutakax/grpc-health-check",
  "version": "0.2.0",
  "license": "MIT",
  "exports": "./src/index.ts",
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check **/*.ts",
    "test": "deno test --allow-env",
    "generate": "buf generate",
    "publish": "deno publish",
    "npmbuild": "deno run -A src/buildNpm.ts 0.2.0",
    "npmpublish": "cd npm && npm publish"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": false
  },
  "imports": {
    "@bufbuild/protobuf": "npm:@bufbuild/protobuf@^2.5.0",
    "@bufbuild/protoc-gen-es": "npm:@bufbuild/protoc-gen-es@^2.5.0",
    "@connectrpc/connect": "npm:@connectrpc/connect@^2.0.2",
    "@connectrpc/connect-node": "npm:@connectrpc/connect-node@^2.0.2",
    "@deno/dnt": "jsr:@deno/dnt@^0.42.1",
    "@std/assert": "jsr:@std/assert@^1.0.13"
  },
  "exclude": ["node_modules", "npm"],
  "nodeModulesDir": "auto"
}
