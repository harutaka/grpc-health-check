{
  "tasks": {
    "test": "deno test",
    "external": "deno run -A src/checkExternal.ts",
    "local": "deno run -A src/checkLocal.ts",
    "publish": "deno run -A scripts/build_npm.ts 0.2.0 && cd npm && npm publish"
  },
  "fmt": {
    "lineWidth": 120,
    "semiColons": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "imports": {
    "@deno/dnt": "jsr:@deno/dnt@^0.42.1",
    "@grpc/grpc-js": "npm:@grpc/grpc-js@^1.13.4",
    "@grpc/proto-loader": "npm:@grpc/proto-loader@^0.7.15",
    "@std/expect": "jsr:@std/expect@^1.0.16",
    "@std/path": "jsr:@std/path@^1.0.9",
    "@std/testing": "jsr:@std/testing@^1.0.12"
  },
  "nodeModulesDir": "auto"
}